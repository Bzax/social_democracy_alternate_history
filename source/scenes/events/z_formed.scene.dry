on-arrival: {!
// set up the infrastructure
Q.z_formed = 1;
Q.parties.push('z');

Q.homeowner_z = 10;
Q.homeowner_a -= 8;
Q.pettyb_z = 3;
Q.pettyb_a -= 3;
Q.public_homeowner_z = 6;
Q.public_homeowner_a -= 4;
Q.rural_z = 2;
Q.unemployed_z = 2;

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_z += 8;
}

// update all records
Q.z_r = 0;
Q.old_z_r = 0;
for (var record of Q.election_records) {
    record['z'] = 0;
}
for (var record of Q.party_support_records) {
    record['z'] = 0;
}
!}
